+/* === ECLL ACERVO BATIZADOS V3 - quadros modernos (2026-08-15) === */
+/* Regras isoladas em .acervo-batizados/.album-pagina para preservar o restante do portal. */
+.acervo-batizados{max-width:1180px;margin:72px auto 0;padding:0}
+.acervo-batizados-titulo{max-width:920px;margin:0 auto 28px;text-align:center}
+.acervo-batizados-titulo>span{display:inline-block;margin-bottom:8px;color:var(--ouro);font-size:11px;font-weight:950;letter-spacing:3px;text-transform:uppercase}
+.acervo-batizados-titulo h2{margin:0;color:var(--azul);font-family:Georgia,"Times New Roman",serif;font-size:54px;line-height:.95;letter-spacing:-1px;text-transform:uppercase}
+.acervo-batizados-titulo h2:after{content:"";display:block;width:70px;height:4px;margin:13px auto 0;border-radius:999px;background:var(--ouro)}
+.acervo-batizados-titulo p{max-width:850px;margin:16px auto 0;color:#4f5967;font-size:14px;line-height:1.7}
+
+.acervo-batizados-legenda{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;max-width:900px;margin:28px auto 48px;padding:0;background:transparent;border:0}
+.acervo-batizados-legenda span{display:flex;align-items:center;min-height:64px;padding:12px 16px;border:1px solid rgba(23,63,138,.18);border-radius:14px;background:linear-gradient(135deg,#fff,#f8faff);box-shadow:0 8px 24px rgba(7,31,74,.06);color:#3e4856;font-size:12px;font-weight:700}
+.acervo-batizados-legenda b{display:grid;place-items:center;flex:0 0 35px;height:35px;margin-right:11px;border-radius:50%;background:var(--ouro);color:var(--azul);font-size:12px;font-weight:950;box-shadow:0 0 0 4px rgba(243,180,0,.13)}
+
+.acervo-anos-lista{display:grid;gap:42px}
+.acervo-ano-bloco{position:relative}
+.acervo-ano-faixa{display:flex;align-items:center;gap:16px;margin:0 0 14px;padding:0;background:none;border:0}
+.acervo-ano-faixa>div{display:flex;align-items:center;gap:0;min-width:158px}
+.acervo-ano-faixa>div>span{display:none}
+.acervo-ano-faixa h3{position:relative;z-index:2;min-width:148px;margin:0;padding:8px 26px 9px 28px;clip-path:polygon(12% 0,100% 0,88% 100%,0 100%);background:linear-gradient(135deg,#071f4a,#173f8a);color:#fff;font-size:26px;line-height:1;font-weight:950;text-align:center;box-shadow:0 8px 20px rgba(7,31,74,.12)}
+.acervo-ano-faixa:after{content:"";height:1px;flex:1;background:linear-gradient(90deg,var(--ouro),rgba(243,180,0,.18))}
+.acervo-ano-faixa>p{display:none}
+
+.acervo-quadros-grade{display:grid!important;grid-template-columns:1fr!important;gap:14px!important}
+.acervo-quadro{display:grid!important;grid-template-columns:minmax(300px,40%) minmax(0,1fr)!important;min-height:210px;overflow:hidden;border:1px solid rgba(23,63,138,.19)!important;border-radius:15px!important;background:#fff!important;box-shadow:0 10px 28px rgba(7,31,74,.08)!important;text-decoration:none!important;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}
+.acervo-quadro:hover{transform:translateY(-3px);border-color:rgba(243,180,0,.65)!important;box-shadow:0 17px 38px rgba(7,31,74,.13)!important}
+.acervo-quadro-primeiro{border-color:rgba(243,180,0,.48)!important}
+.acervo-quadro-capa{position:relative;min-height:210px!important;overflow:hidden;background:#071f4a}
+.acervo-quadro-capa img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .4s ease}
+.acervo-quadro:hover .acervo-quadro-capa img{transform:scale(1.035)}
+.acervo-quadro-capa:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,31,74,.02),rgba(7,31,74,.30));pointer-events:none}
+.acervo-quadro-capa-vazia{display:grid;place-items:center;background:radial-gradient(circle at 25% 18%,rgba(243,180,0,.12),transparent 29%),linear-gradient(135deg,#071f4a 0%,#173f8a 58%,#0a285d 100%)}
+.acervo-quadro-capa-vazia:before{content:"";position:absolute;inset:-20%;background:repeating-linear-gradient(135deg,transparent 0 45px,rgba(255,255,255,.035) 46px 47px);transform:rotate(-4deg)}
+.acervo-quadro-selo{position:absolute;z-index:3;top:16px;left:16px;padding:6px 10px;border-radius:999px;background:var(--ouro);color:var(--azul);font-size:10px;font-weight:950;letter-spacing:.5px}
+.acervo-capa-identidade{position:relative;z-index:2;display:grid;justify-items:center;color:#fff;text-align:center;text-transform:uppercase}
+.acervo-capa-identidade strong{font-family:Georgia,"Times New Roman",serif;color:var(--ouro);font-size:56px;line-height:.9}
+.acervo-capa-identidade span{margin-top:7px;font-size:13px;font-weight:950;letter-spacing:2px}
+.acervo-capa-identidade small{margin-top:12px;padding:6px 10px;border:1px solid rgba(255,255,255,.25);border-radius:999px;color:rgba(255,255,255,.68);font-size:8px;font-weight:900;letter-spacing:1px}
+.acervo-quadro-placeholder{position:relative;z-index:2}
+
+.acervo-quadro-conteudo{display:flex!important;min-width:0;flex-direction:column;justify-content:center;padding:25px 28px 22px!important;border-left:4px solid var(--ouro)}
+.acervo-quadro-topo{display:flex;flex-direction:column;align-items:flex-start}
+.acervo-quadro-topo .acervo-quadro-ano{display:inline-flex!important;margin:0 0 7px!important;padding:4px 10px;border-radius:999px;background:var(--azul);color:#fff!important;font-size:10px!important;line-height:1;font-weight:950!important;letter-spacing:.4px!important;text-transform:none!important}
+.acervo-quadro-topo strong{display:block;color:var(--azul);font-family:Georgia,"Times New Roman",serif;font-size:31px!important;line-height:1.05}
+.acervo-quadro-conteudo>p{max-width:650px;margin:11px 0 18px!important;color:#596473!important;font-size:13px!important;line-height:1.55!important}
+.acervo-quadro-rodape{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:18px;margin-top:auto!important;padding-top:14px!important;border-top:1px solid #edf0f4!important;color:#5b6674!important;font-size:10px!important;font-weight:850!important;text-transform:none!important;letter-spacing:0!important}
+.acervo-quadro-rodape>span:first-child{display:flex;align-items:center;gap:5px}
+.acervo-quadro-rodape>span:first-child:before{content:"▧";display:grid;place-items:center;width:22px;height:22px;border:1px solid rgba(23,63,138,.25);border-radius:6px;color:var(--royal);font-size:13px}
+.acervo-quadro-rodape b{color:var(--azul)!important;font-size:13px!important}
+.acervo-quadro-acao{display:inline-flex;align-items:center;justify-content:center;min-width:145px;min-height:42px;padding:0 16px;border-radius:8px;background:var(--ouro);color:var(--azul)!important;font-size:10px;font-weight:950;text-transform:uppercase;letter-spacing:.5px;box-shadow:0 7px 16px rgba(243,180,0,.18)}
+.acervo-quadro-acao i{margin-left:7px;font-size:15px;font-style:normal;transition:transform .2s ease}
+.acervo-quadro:hover .acervo-quadro-acao i{transform:translateX(4px)}
+
+/* Página individual do álbum: título limpo, fotos e acesso ao Drive. */
+.album-pagina{max-width:1180px;margin-inline:auto}
+.album-kicker{display:inline-flex!important;padding:5px 11px!important;border-radius:999px!important;background:var(--azul)!important;color:#fff!important;font-size:10px!important;letter-spacing:.5px!important}
+.album-descricao h2{font-family:Georgia,"Times New Roman",serif}
+.album-drive-flutuante{z-index:40}
+
+@media(max-width:980px){
+  .acervo-batizados{margin-top:58px}
+  .acervo-batizados-titulo h2{font-size:46px}
+  .acervo-quadro{grid-template-columns:280px minmax(0,1fr)!important}
+  .acervo-quadro-conteudo{padding:22px!important}
+}
+@media(max-width:700px){
+  .acervo-batizados{margin-top:46px}
+  .acervo-batizados-titulo{text-align:left}
+  .acervo-batizados-titulo h2{font-size:39px}
+  .acervo-batizados-titulo h2:after{margin-left:0}
+  .acervo-batizados-titulo p{font-size:13px}
+  .acervo-batizados-legenda{grid-template-columns:1fr;margin:22px 0 34px;gap:8px}
+  .acervo-batizados-legenda span{min-height:52px}
+  .acervo-anos-lista{gap:32px}
+  .acervo-ano-faixa h3{min-width:122px;padding:7px 20px;font-size:23px}
+  .acervo-quadro{grid-template-columns:1fr!important;min-height:0}
+  .acervo-quadro-capa{min-height:220px!important;aspect-ratio:16/9}
+  .acervo-quadro-conteudo{padding:20px 18px!important;border-left:0;border-top:4px solid var(--ouro)}
+  .acervo-quadro-topo strong{font-size:27px!important}
+  .acervo-quadro-rodape{align-items:stretch!important;flex-direction:column!important}
+  .acervo-quadro-acao{width:100%}
+}
+@media(max-width:420px){
+  .acervo-batizados-titulo h2{font-size:34px}
+  .acervo-quadro-capa{min-height:190px!important}
+  .acervo-capa-identidade strong{font-size:48px}
+}
